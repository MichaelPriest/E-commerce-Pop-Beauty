# Popê Beauty | exemplo local — NUNCA incluir tokens reais no Git.
# Configuração necessária para conectar Supabase (chave pública / publishable).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# E-mail de pedidos — configurar SOMENTE no servidor/ambiente privado:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_FROM_EMAIL=
# SMTP_PASSWORD=

# Frete: apenas sandbox, não compra etiquetas:
# MELHOR_ENVIO_SANDBOX_TOKEN=

# Checkout Pro Mercado Pago TEST — nunca usar credenciais de vendedor real:
# MP_TEST_ACCESS_TOKEN=
# MP_TEST_SELLER_ID=
# MP_TEST_PREFERENCE_CREATION_ENABLED=verified-test-account-only

# Webhook Mercado Pago TEST — manter DESATIVADO até configurar tudo:
# MP_TEST_WEBHOOK_SECRET=
# MP_TEST_WEBHOOK_ENABLED=verified-test-account-only
# SUPABASE_SERVICE_ROLE_KEY=

# A existência destas variáveis não libera o checkout comercial.
# Não definir flags TEST com dados de produção.
