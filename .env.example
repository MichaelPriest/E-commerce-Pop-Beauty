# Popê Beauty | exemplo local — NUNCA incluir tokens reais no Git.
# Configuração necessária para conectar Supabase (chave pública / publishable).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# E-mail de pedidos — configurar SOMENTE no servidor/ambiente privado:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_FROM_EMAIL=
# SMTP_PASSWORD=

# Frete: apenas sandbox, não compra etiquetas:
# MELHOR_ENVIO_SANDBOX_TOKEN=

# Checkout Pro Mercado Pago TEST — nunca usar credenciais de vendedor real:
# MP_TEST_ACCESS_TOKEN=
# MP_TEST_SELLER_ID=
# MP_TEST_PREFERENCE_CREATION_ENABLED=verified-test-account-only

# Webhook Mercado Pago TEST — manter DESATIVADO até configurar tudo:
# MP_TEST_WEBHOOK_SECRET=
# MP_TEST_WEBHOOK_ENABLED=verified-test-account-only
# SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago para pedidos internos. Configure na etapa de homologação comercial.
# MP_LIVE_ACCESS_TOKEN=
# MP_LIVE_SELLER_ID=
# MP_LIVE_WEBHOOK_SECRET=
# MP_LIVE_WEBHOOK_ENABLED=verified-live-account-only
# MP_LIVE_SITE_ORIGIN=https://e-commerce-pope-beauty.vercel.app
# MP_LIVE_PAYMENT_LINKS_ENABLED=internal-orders

# NF-e 55 via Focus NFe. O ambiente seleciona a credencial correspondente.
# FOCUS_NFE_ENVIRONMENT=homologacao
# FOCUS_NFE_HOMOLOGACAO_TOKEN=
# FOCUS_NFE_PRODUCAO_TOKEN=

# Etiquetas Melhor Envio. Sandbox usa o token SANDBOX declarado acima.
# MELHOR_ENVIO_LABEL_ENVIRONMENT=sandbox
# MELHOR_ENVIO_PRODUCTION_TOKEN=
# MELHOR_ENVIO_CONTACT_EMAIL=
# MELHOR_ENVIO_SENDER_PHONE=

# Shopee Open Platform (aplicação da sua conta de vendedor)
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=

# Mercado Livre DevCenter (aplicação OAuth distinta de Mercado Pago)
# MELI_APP_ID=
# MELI_CLIENT_SECRET=

# Cofre OAuth compartilhado (64 caracteres hex / 32 bytes aleatórios).
# MARKETPLACE_TOKEN_ENCRYPTION_KEY=
# MARKETPLACE_OAUTH_ORIGIN=https://e-commerce-pope-beauty.vercel.app
# Nunca reutilizar credenciais MP_TEST_* como MELI_*.
